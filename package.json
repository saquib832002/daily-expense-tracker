    "@types/react": "~18.3.12",
    "babel-plugin-inline-import": "^3.0.0",
    "drizzle-kit": "^0.31.10",
    "jest": "^30.0.0",
    "ts-jest": "^29.2.0",
    "typescript": "~5.3.3"
  }
